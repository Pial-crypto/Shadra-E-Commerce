// ======================================================
// Prisma Generator
// ======================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// ======================================================
// Database
// ======================================================

datasource db {
  provider = "postgresql"
  
}

// ======================================================
// Enums
// ======================================================

enum Category {
  POWER_BANKS
  CHARGERS
  HEADPHONES
  EARBUDS
  SMART_WATCHES
  ACCESSORIES
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKAGING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ======================================================
// Product
// ======================================================

model Product {

  id                String    @id @default(cuid())

  title             String

  slug              String    @unique

  images            String[]

  shortDescription  String

  description       String

  specifications    Json?

  category          Category

  price             Float

  oldPrice          Float?

  stock             Int       @default(0)

  badge             String?

  discount          Float?

  warranty          String?

  isFeatured        Boolean   @default(false)

  createdAt         DateTime  @default(now())

  updatedAt         DateTime  @updatedAt

  orderItems        OrderItem[]

}

// ======================================================
// Order
// ======================================================

model Order {

  id                String       @id @default(cuid())

  customerName      String

  phone             String

  address           String

  area              String

  note              String?

  subtotal          Float

  deliveryCharge    Float

  total             Float

  status            OrderStatus @default(PENDING)

  createdAt         DateTime     @default(now())

  updatedAt         DateTime     @updatedAt

  items             OrderItem[]

}

// ======================================================
// Order Items
// ======================================================

model OrderItem {

  id          String   @id @default(cuid())

  quantity    Int

  price       Float

  orderId     String

  productId   String

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product     Product  @relation(fields: [productId], references: [id])

}